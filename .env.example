# Runtime: Cloudflare Worker, D1 binding DB managed by Sites. No DATABASE_URL.
# Authentication: Sites private SIWC gateway; never expose the raw Worker publicly.
# Always production on the production Site; development/test fixtures are opt-in.
APP_ENV=production
# HTTPS origin of the existing Site, without a trailing slash.
APP_ORIGIN=
# Comma-separated platform administrators. Empty means access denied.
ADMIN_EMAILS=

# Optional server-only Gemini API. Both values required; local generation is the fallback.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional licensed REST provider; HTTPS, no redirects, authorized retention/export.
LEAD_PROVIDER_URL=
LEAD_PROVIDER_KEY=

# OSM: explicit searches only, max radius 20km, one query at a time per endpoint.
# APP_ORIGIN (real HTTPS Site) identifies both providers; optional operator email.
# OVERPASS_URL can use an authorized private/commercial endpoint; no endpoint rotation.
GEOCODING_URL=https://nominatim.openstreetmap.org/search
OVERPASS_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter
NOMINATIM_CONTACT=

# Optional trusted audit proxy. Must attest public DNS, all redirects and robots.
WEBSITE_AUDIT_URL=
WEBSITE_AUDIT_KEY=

# Global rolling 24-hour request ceilings, in addition to user credits and rate limits.
GLOBAL_SEARCH_DAILY_LIMIT=1000
GLOBAL_AI_DAILY_LIMIT=200
GLOBAL_AUDIT_DAILY_LIMIT=300

# External scheduler POST /api/internal/run; monitors start paused.
SCHEDULER_ENABLED=false
WORKER_SECRET=
