# Next.js/Vercel. Configure values through environment/secret stores; never commit them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only existing orbit_backend connection, transaction pooler port 6543.
# Postgres.js uses prepare:false, verified TLS and transaction-local verified JWT claims.
DATABASE_URL=
APP_ENV=production
# Canonical HTTPS origin. Preview falls back to the platform-provided VERCEL_URL.
APP_ORIGIN=
ADMIN_EMAILS=

# Optional server-only Gemini. Both required; local niche generation remains available.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional licensed provider, HTTPS and authorized retention/export.
LEAD_PROVIDER_URL=
LEAD_PROVIDER_KEY=
# Explicit OSM searches, bounded timeout/concurrency and persistent cache.
GEOCODING_URL=https://nominatim.openstreetmap.org/search
OVERPASS_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter
NOMINATIM_CONTACT=
# Optional trusted audit proxy; validates public DNS, redirects and robots.
WEBSITE_AUDIT_URL=
WEBSITE_AUDIT_KEY=
GLOBAL_SEARCH_DAILY_LIMIT=1000
GLOBAL_AI_DAILY_LIMIT=200
GLOBAL_AUDIT_DAILY_LIMIT=300
# Optional authenticated scheduler; monitors start paused.
SCHEDULER_ENABLED=false
SCHEDULER_SECRET=
