{
  "name": "orbit-local-intelligence",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "install:ci": "pnpm install --frozen-lockfile",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "APP_ENV=test node --conditions=react-server --import tsx --test tests/*.test.ts tests/auth.test.mjs tests/postgres.test.mjs",
    "format": "prettier --write app components/orbit lib tests docs README.md",
    "predeploy": "node scripts/predeploy.mjs",
    "test:database": "node --import tsx --test tests/database.test.mjs",
    "test:provider-live": "node --conditions=react-server --import tsx scripts/provider-live.mjs",
    "check:env": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "fflate": "0.8.3",
    "input-otp": "^1.4.2",
    "leaflet": "1.9.4",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "postgres": "3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
